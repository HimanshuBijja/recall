# MongoDB — the app connects to MONGODB_URI (Atlas = source of truth).
# Copy this file to .env.local and fill in real values.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=recall

# Local mongod used only as a one-way mirror of Atlas (npm run sync:local /
# dev:synced / mirror:watch). The app never uses this as its data source.
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/?retryWrites=false

# No auth is configured for this app — these vars are unused but kept for future use.
APP_PASSWORD=your-password-here
SESSION_SECRET=a-long-random-secret-string

# Cloudflare R2 (frame screenshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
